import { ChangeDetectionStrategy, Component, inject } from '@angular/core';
import { BreakpointObserver } from '@angular/cdk/layout';
import { toSignal } from '@angular/core/rxjs-interop';
import { map } from 'rxjs';

@Component({
  selector: 'app-main-navigation',
  changeDetection: ChangeDetectionStrategy.OnPush,
  templateUrl: './main-navigation.component.html',
  styleUrl: './main-navigation.component.scss',
})
export class MainNavigationComponent {
  protected readonly menuState = inject(MenuStateService);
  private readonly breakpoints = inject(BreakpointObserver);

  protected readonly isHandset = toSignal(
    this.breakpoints.observe('(max-width: 767.98px)').pipe(map((r) => r.matches)),
    { initialValue: false },
  );

  protected onRailClick(rail: MenuDefinition): void {
    this.menuState.selectRail(rail.id);   // your existing behavior — unchanged on desktop
  }
}




<nav class="rail-nav" [class.rail-nav--handset]="isHandset()" aria-label="Main navigation">
  @for (rail of menuState.menuDefinitions(); track rail.id) {
    <button
      type="button"
      class="rail-item"
      [class.active]="rail.id === menuState.selectedRailItemId()"
      [attr.aria-expanded]="isHandset() && rail.groups.length ? (rail.id === menuState.selectedRailItemId()) : null"
      (click)="onRailClick(rail)">
      <span class="rail-label">{{ rail.title }}</span>
      @if (rail.groups.length > 0) {
        <i class="pi rail-arrow"
           [class.pi-angle-right]="!isHandset() || rail.id !== menuState.selectedRailItemId()"
           [class.pi-angle-down]="isHandset() && rail.id === menuState.selectedRailItemId()"
           aria-hidden="true"></i>
      }
    </button>

    @if (isHandset() && rail.id === menuState.selectedRailItemId()) {
      <div class="rail-accordion" role="region">
        @for (group of rail.groups; track group.id) {
          <div class="rail-accordion__group">
            <span class="rail-accordion__heading">{{ group.title }}</span>
            @if (group.subtitle) {
              <span class="rail-accordion__subtitle">{{ group.subtitle }}</span>
            }
            <ul class="rail-accordion__items">
              @for (item of group.items; track item.id) {
                <li>
                  <button type="button" class="rail-accordion__link" (click)="menuState.selectItem?.(item)">
                    {{ item.title }}
                    @if (item.isExternal) {
                      <i class="link-ext" aria-hidden="true"></i>
                    }
                  </button>
                </li>
              }
            </ul>
          </div>
        }
      </div>
    }
  }
</nav>




.rail-nav--handset {
  display: flex;
  flex-direction: column;

  .rail-item {
    justify-content: space-between;
    width: 100%;
    padding: 14px 20px;
    border-bottom: 1px solid #cfdccf;
  }

  .rail-accordion {
    background: #fff;
    border-bottom: 1px solid #eef0f2;

    &__group { padding: 4px 0 8px; }

    &__heading {
      display: block;
      padding: 12px 20px 2px;
      font-size: 13px;
      font-weight: 700;
      color: #1f7a1f;              // matches your green section headings
    }

    &__subtitle {
      display: block;
      padding: 0 20px 6px;
      font-size: 12px;
      color: #6b7280;
    }

    &__items { margin: 0; padding: 0; list-style: none; }

    &__link {
      display: flex;
      align-items: center;
      gap: 6px;
      width: 100%;
      padding: 10px 28px;
      border: none;
      background: none;
      font: inherit;
      text-align: left;
      color: #111827;
      cursor: pointer;

      &:hover,
      &:focus-visible { background: #eef2f7; }
    }
  }
}




@media (max-width: 767px) {
  .mega-menu-panel {
    grid-template-columns: 1fr;          // was 190px 1fr
    width: min(88vw, 360px);
    min-height: 100dvh;
    max-height: 100dvh;
    box-shadow: 2px 0 24px rgb(0 0 0 / 25%);
    animation: drawerIn 0.22s ease forwards;
    overscroll-behavior: contain;
  }

  .mega-menu-left {
    border-right: none;                  // divider no longer needed between panes
  }

  .mega-menu-right {
    display: none;                       // groups render inline in the rail instead
  }
}

@keyframes drawerIn {
  from { transform: translateX(-100%); opacity: 0; }
  to   { transform: translateX(0);     opacity: 1; }
}
