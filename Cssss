@media (max-width: 767px) {
  .mega-menu-panel {
    grid-template-columns: 1fr;          // stack: rail on top, groups below
    width: min(88vw, 360px);
    min-height: 100dvh;
    max-height: 100dvh;
    border-top: none;
    box-shadow: 2px 0 24px rgb(0 0 0 / 25%);
    animation: drawerIn 0.22s ease forwards;
    overscroll-behavior: contain;
  }

  .mega-menu-left {
    border-right: none;
    border-bottom: 1px solid #cfdccf;    // divider now runs horizontally
  }

  .mega-menu-right {
    padding: 1rem 1.25rem 1.5rem;        // tighter than desktop's 1.75/2.25
  }
}

@keyframes drawerIn {
  from { transform: translateX(-100%); opacity: 0; }
  to   { transform: translateX(0);     opacity: 1; }
}
